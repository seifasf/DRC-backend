PORT=5050
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/drc_db?appName=Cluster0
# Pool and timeouts (Atlas: allow app IP; use retryWrites=true in URI for writes)
# MONGO_MAX_POOL_SIZE=25
# MONGO_MIN_POOL_SIZE=2
# MONGO_SERVER_SELECTION_MS=8000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_MAX_IDLE_MS=60000

# Use a long random secret in production (min 32 chars; not the placeholder below).
# Generate one locally: npm run gen:jwt-secret   (in this folder)
# On Render: use Environment → JWT_SECRET with “Generate” in the dashboard, or add to render.yaml:
#   - key: JWT_SECRET
#     generateValue: true
JWT_SECRET=change_me_to_a_long_random_string
# Access token lifetime (e.g. 45d, 90d). Longer = fewer logins; shorten if tokens might leak.
JWT_EXPIRES_IN=45d

# Rate limits (express-rate-limit): per IP unless TRUST_PROXY passes real client IP.
# All /api/v1 requests per 15 minutes (default 2000).
API_RATE_LIMIT_MAX=2000
# POST /auth/login per 15 minutes (brute-force guard; default 30).
LOGIN_RATE_LIMIT_MAX=30
# POST /auth/register per hour when not blocked by admin gate (default 20).
REGISTER_RATE_LIMIT_MAX=20

# Browser CORS: comma-separated origins, no trailing slash.
# Production (Vercel SPA): include your exact live URL:
CORS_ORIGINS=https://drc-system.vercel.app
# Local dev with Vercel URL + Vite:
# CORS_ORIGINS=https://drc-system.vercel.app,http://localhost:5173

# Local: PORT=5050. On Render, PORT is injected — leave Render’s PORT as default.
NODE_ENV=development

# On Render (or any reverse proxy): set to 1 for correct client IPs in rate limiting.
# TRUST_PROXY=1
